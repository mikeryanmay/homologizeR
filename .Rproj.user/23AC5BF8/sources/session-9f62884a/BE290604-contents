class Node {

    public:

        Node() = default;

        // Accessors
        const std::string& name() const { return name_; }
        double branch_length() const { return branch_length_; }
        Node* parent() const { return parent_; }
        const std::vector<Node*>& children() const { return children_; }

        bool is_leaf() const { return children_.empty(); }

    private:

        friend class Tree;
        friend class NewickParser;

        std::string name_;            // optional label (leaf or internal)
        double branch_length_ = 0.0;  // length from parent -> this node
        Node* parent_ = nullptr;      // ancestor (nullptr for root)
        std::vector<Node*> children_; // descendants

};

class Tree {

    public:

        Tree() = default;
        Node* root() const { return root_; }
        std::size_t size() const { return storage_.size(); }

    private:

        friend class NewickParser;

        Node* make_node() {
            storage_.emplace_back(std::make_unique<Node>());
            return storage_.back().get();
        }

        std::vector<std::unique_ptr<Node>> storage_; // owns all nodes
        Node* root_ = nullptr;

};

class NewickParser {

    public:
        explicit NewickParser(std::string_view input) : s_(input) {}

        Tree parse_tree() {
            Tree t;

            skip_ws_and_brackets();
            Node* root = parse_subtree(t, nullptr);

            skip_ws_and_brackets();
            if (!consume_char(';')) {
                throw error("Expected ';' at end of Newick string");
            }
            skip_ws_and_brackets();
            if (!eof()) {
                throw error("Unexpected trailing characters after ';'");
            }

            t.root_ = root;
            return t;
        }

    private:
        std::string_view s_;
        std::size_t i_ = 0;

        Node* parse_subtree(Tree& t, Node* parent) {
            skip_ws_and_brackets();

            Node* n = t.make_node();
            n->parent_ = parent;
            if (parent) parent->children_.push_back(n);

            if (peek_char_raw() == '(') {
                consume_char('(');
                skip_ws_and_brackets();

                // at least one child
                parse_subtree(t, n);
                skip_ws_and_brackets();

                while (consume_char(',')) {
                    skip_ws_and_brackets();
                    parse_subtree(t, n);
                    skip_ws_and_brackets();
                }

                if (!consume_char(')')) {
                    throw error("Expected ')' to close child list");
                }

                skip_ws_and_brackets();
                parse_optional_label_and_length(*n);
            } else {
                // leaf
                parse_optional_label_and_length(*n);
            }

            return n;
        }

        void parse_optional_label_and_length(Node& n) {
            skip_ws_and_brackets();

            // label
            std::string label = parse_label(); // stops before '[' as well
            if (!label.empty()) n.name_ = std::move(label);

            // ignore any BEAST-style bracket data like [&index=...]
            skip_ws_and_brackets();

            // branch length
            if (consume_char(':')) {
                skip_ws_and_brackets();
                n.branch_length_ = parse_number();
                skip_ws_and_brackets();
            }

            // also ignore any bracket data after branch length if it occurs (rare, but harmless)
            skip_ws_and_brackets();
        }

        std::string parse_label() {
            skip_ws_and_brackets();

            std::string out;
            while (!eof()) {
                char c = s_[i_];
                // Stop on Newick delimiters, whitespace, or bracket annotation start
                if (c == ':' || c == ',' || c == ')' || c == ';' ||
                    c == '[' || std::isspace((unsigned char)c)) {
                    break;
                }
                out.push_back(c);
                ++i_;
            }
            return out;
        }

        double parse_number() {
            if (eof()) throw error("Expected number, got end-of-input");

            std::size_t start = i_;
            while (!eof()) {
                char c = s_[i_];
                // number ends at delimiters, whitespace, or bracket annotation
                if (c == ',' || c == ')' || c == ';' || c == '[' ||
                    std::isspace((unsigned char)c)) {
                    break;
                }
                ++i_;
            }

            std::string token(s_.substr(start, i_ - start));
            if (token.empty()) throw error("Expected number after ':'");

            char* endptr = nullptr;
            const char* cstr = token.c_str();
            double val = std::strtod(cstr, &endptr);
            if (endptr == cstr || *endptr != '\0') {
                throw error("Invalid number token: '" + token + "'");
            }
            return val;
        }

        // Skips whitespace and any [ ... ] bracket blocks (including [&index=...] etc.)
        void skip_ws_and_brackets() {
            for (;;) {
                while (!eof() && std::isspace((unsigned char)s_[i_])) ++i_;

                if (!eof() && s_[i_] == '[') {
                    ++i_;
                    while (!eof() && s_[i_] != ']') ++i_;
                    if (eof()) throw error("Unterminated bracket block '[' ...");
                    ++i_; // consume ']'
                    continue;
                }
                break;
            }
        }

        bool consume_char(char expected) {
            skip_ws_and_brackets();
            if (!eof() && s_[i_] == expected) {
                ++i_;
                return true;
            }
            return false;
        }

        // Peek without skipping (useful for detecting '(' at subtree start)
        char peek_char_raw() const {
            if (eof()) return '\0';
            return s_[i_];
        }

        bool eof() const { return i_ >= s_.size(); }

        std::runtime_error error(const std::string& msg) const {
            return std::runtime_error("Newick parse error at pos " + std::to_string(i_) +
                                      ": " + msg);
        }

};

// ---------- small helpers ----------

static inline std::string trim(std::string s) {
    auto not_space = [](unsigned char c){ return !std::isspace(c); };
    s.erase(s.begin(), std::find_if(s.begin(), s.end(), not_space));
    s.erase(std::find_if(s.rbegin(), s.rend(), not_space).base(), s.end());
    return s;
}

static std::string to_lower(std::string s) {
    for (char& c : s) c = (char)std::tolower((unsigned char)c);
    return s;
}

static std::vector<std::string> split_tsv_line(const std::string& line) {
    std::vector<std::string> out;
    std::string cur;
    for (char c : line) {
        if (c == '\t') {
            out.push_back(cur);
            cur.clear();
        } else {
            cur.push_back(c);
        }
    }
    out.push_back(cur);
    return out;
}

static std::int64_t parse_int64(const std::string& s) {
    std::string t = trim(s);
    if (t.empty()) throw std::runtime_error("Empty integer field");
    char* endptr = nullptr;
    long long v = std::strtoll(t.c_str(), &endptr, 10);
    if (endptr == t.c_str() || *endptr != '\0')
        throw std::runtime_error("Invalid integer token: '" + t + "'");
    return (std::int64_t)v;
}

// normalize header names (case-insensitive, alnum-only)
static std::size_t find_column_by_name(
        const std::vector<std::string>& header,
        const std::vector<std::string>& candidates
) {
    auto normalize = [](std::string x) {
        x = to_lower(trim(x));
        std::string out;
        for (char c : x) if (std::isalnum((unsigned char)c)) out.push_back(c);
        return out;
    };

    std::vector<std::string> cand_norm;
    for (const auto& c : candidates) cand_norm.push_back(normalize(c));

    for (std::size_t j = 0; j < header.size(); ++j) {
        std::string hj = normalize(header[j]);
        for (const auto& cn : cand_norm) {
            if (hj == cn) return j;
        }
    }
    throw std::runtime_error("Required column not found in header");
}

// ---------- Newick-column detection helpers ----------

static std::string strip_brackets(const std::string& s) {
    std::string out;
    bool in_bracket = false;
    for (char c : s) {
        if (!in_bracket) {
            if (c == '[') in_bracket = true;
            else out.push_back(c);
        } else {
            if (c == ']') in_bracket = false;
        }
    }
    return out;
}

static bool parens_balanced(const std::string& s) {
    int bal = 0;
    for (char c : s) {
        if (c == '(') ++bal;
        else if (c == ')') {
            --bal;
            if (bal < 0) return false;
        }
    }
    return bal == 0;
}

static int newick_score(const std::string& field_raw) {
    std::string f = trim(field_raw);
    if (f.empty()) return 0;

    std::string g = strip_brackets(f);

    bool has_parens = g.find('(') != std::string::npos &&
                             g.find(')') != std::string::npos;
    bool has_semicolon = g.find(';') != std::string::npos;
    bool ends_semicolon = !g.empty() && g.back() == ';';
    bool balanced = parens_balanced(g);
    bool has_colon = g.find(':') != std::string::npos;

    int score = 0;
    if (has_parens) score += 3;
    if (has_semicolon) score += 3;
    if (ends_semicolon) score += 2;
    if (balanced) score += 3;
    if (has_colon) score += 1;

    return score;
}

static std::size_t detect_newick_column(
        const std::vector<std::string>& header,
        const std::vector<std::vector<std::string>>& sample_rows
) {
    std::vector<int> scores(header.size(), 0);
    for (std::size_t j = 0; j < header.size(); ++j) {
        for (const auto& row : sample_rows) {
            if (j < row.size()) scores[j] += newick_score(row[j]);
        }
    }

    auto it = std::max_element(scores.begin(), scores.end());
    if (it == scores.end() || *it == 0)
        throw std::runtime_error("Could not detect Newick column");

    return (std::size_t)std::distance(scores.begin(), it);
}

// ---------- MAIN READER ----------

static std::map<std::int64_t, Tree>
    read_tsv_and_parse_trees_by_iteration(
        const std::string& filepath,
        std::size_t sample_rows_to_detect = 5
    ) {

    std::ifstream in(filepath);
    if (!in) throw std::runtime_error("Failed to open file: " + filepath);

    std::string line;

    // ---- header ----
    if (!std::getline(in, line))
        throw std::runtime_error("File is empty: " + filepath);

    auto header = split_tsv_line(line);

    // iteration column
    std::size_t iter_col =
        find_column_by_name(header, {"Iteration", "iter", "iteration"});

    // ---- sample rows for Newick detection ----
    std::vector<std::vector<std::string>> samples;
    std::vector<std::vector<std::string>> buffered_rows;

    while (samples.size() < sample_rows_to_detect &&
           std::getline(in, line)) {
        if (line.empty()) continue;
        auto row = split_tsv_line(line);
        buffered_rows.push_back(row);
        samples.push_back(row);
    }

    std::size_t newick_col = detect_newick_column(header, samples);

    // ---- parse trees ----
    std::map<std::int64_t, Tree> trees;

    auto parse_row = [&](const std::vector<std::string>& row) {
        if (iter_col >= row.size() || newick_col >= row.size()) return;

        std::int64_t iter = parse_int64(row[iter_col]);
        std::string nwk = trim(row[newick_col]);
        if (nwk.empty()) return;

        NewickParser parser(nwk);
        trees[iter] = parser.parse_tree();  // overwrite if duplicate
    };

    for (const auto& r : buffered_rows) parse_row(r);

    while (std::getline(in, line)) {
        if (line.empty()) continue;
        auto row = split_tsv_line(line);
        parse_row(row);
    }

    return trees;
}



